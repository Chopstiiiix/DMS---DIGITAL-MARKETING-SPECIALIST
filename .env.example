# Copy to .env.local and fill in. Never commit real values.

# Supabase project that hosts the `dms` schema (currently the shared mot-platform project).
# The publishable key is safe to expose; it only identifies the project.
NEXT_PUBLIC_SUPABASE_URL=https://amxkbtjibfgvykexvkus.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_m9sO51n0diCubkahEou0TQ_-srhD-ET

# Server only. Bypasses row level security; used by the public redirect and audit log.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Server only. Random string used to salt the unique-visitor hash.
# Generate one with: openssl rand -hex 32
LINK_HASH_SALT=

# Comma-separated hosts that serve the DMS app itself (dashboard, login).
# localhost and *.vercel.app are always treated as the app.
# Every other host is treated as a brand's short-link domain.
APP_HOSTS=

# Server only. Spin's read-only reporting role (Radio1 project). Copy the transaction
# pooler URL from Radio1 → Connect, with user dms_reader.<ref> and its password:
# postgresql://dms_reader.feqtoilsffjxctgjsmme:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SPIN_DATABASE_URL=

# Server only. Vercel Cron sends it as a Bearer token. Generate with: openssl rand -hex 32
CRON_SECRET=
